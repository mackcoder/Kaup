@startuml Diagrama_Casos_de_Uso_Scanner_Contratos

left to right direction

actor "Usuário" as Usuario
actor "Sistema de IA" as SistemaIA

rectangle "Sistema de Scanner de Contratos" {
  usecase "Enviar contrato" as UC1
  usecase "Extrair texto (OCR)" as UC2
  usecase "Interpretar contrato" as UC3
  usecase "Visualizar resumo simplificado" as UC4
  usecase "Fazer pergunta sobre contrato" as UC5
  usecase "Fornecer dados financeiros" as UC6
  usecase "Ouvir explicação em áudio" as UC7
}

Usuario --> UC1
Usuario --> UC2
Usuario --> UC3
Usuario --> UC4
Usuario --> UC5
Usuario --> UC6
Usuario --> UC7

SistemaIA --> UC3
SistemaIA --> UC5

UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC5 ..> UC3 : <<include>>

@enduml
