# mock funciona sem backend. api nunca retorna mocks em caso de falha.
VITE_DATA_SOURCE=mock
# Vazio: /api usa proxy Vite para localhost:8080 no desenvolvimento.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=20000

# Opcional, SO para testes: mostra na tela "esqueci a senha" o codigo fixo da recuperacao simulada.
# Deixe vazio em producao.
VITE_FAKE_RESET_CODE=
