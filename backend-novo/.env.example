# Copie para .env e defina uma senha local. Arquivo .env ignorado pelo Git.
DB_NAME=kaup_novo
DB_USER=kaup_app
DB_PASSWORD=
DB_PORT=55432
API_PORT=8080
MAX_UPLOAD_SIZE=10MB
MAX_REQUEST_SIZE=11MB
# Compose fixa profile dev e JDBC interno. Para Maven fora do container:
# export SPRING_PROFILES_ACTIVE=dev
# export DB_PASSWORD=... (o mesmo valor local; Maven não lê .env automaticamente)
# Produção exige SPRING_PROFILES_ACTIVE=prod e SPRING_DATASOURCE_URL/USERNAME/PASSWORD.
# Gemini, OCR e storage ainda não são implementados nem necessários para iniciar.
