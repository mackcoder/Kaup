# Copie para .env (que o git ignora) e preencha. O docker compose lê este arquivo.

# Chave da API do Gemini (obrigatória para analisar contratos e conversar).
GEMINI_API_KEY=

# Modelo do Gemini (opcional; o padrão é gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Conta de administrador, criada na subida se ainda não existir. O administrador vê os
# documentos de TODAS as pessoas. Os padrões abaixo (ADMIN@ADMIN / ADMIN) servem só para
# desenvolvimento: ANTES DE PUBLICAR, defina uma senha forte (ou desligue a conta).
# KAUP_ADMIN_ENABLED=true
# KAUP_ADMIN_EMAIL=ADMIN@ADMIN
# KAUP_ADMIN_PASSWORD=ADMIN

# Recuperação de senha SIMULADA: ainda não há envio de e-mail, então o "código enviado" é sempre
# este valor. Só para desenvolvimento; deixe vazio para desligar a recuperação.
# A conta de administrador nunca tem a senha alterada pelo app, com ou sem código.
# KAUP_CODIGO_FAKE=676869

# Depois de quantos dias os documentos (e conversas) dos usuários são apagados, todo dia às 03:30.
# 0 desliga. A conta em si não expira.
# KAUP_RETENCAO_DIAS=180
